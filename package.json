    "better-auth": "1.7.1",
    "next": "16.3.4",
    "next-intl": "^4.13.2",
    "nodemailer": "9.1.1",
    "pg": "^8.23.0",
    "prisma": "^7.8.0",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "sharp": "^0.35.4",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
