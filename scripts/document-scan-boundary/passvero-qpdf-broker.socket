[Unit]
Description=Passvero staging-only PDF validation socket

[Socket]
ListenStream=/run/passvero-qpdf-broker/validate.sock
SocketUser=root
SocketGroup=passvero-staging
SocketMode=0660
DirectoryMode=0755
Backlog=1
Service=passvero-qpdf-acceptance.service
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
