[Unit]
Description=Passvero staging subscription reminder cycle
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/passvero-subscription-reminders/launch.py scheduled
TimeoutStartSec=210
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/passvero-staging/.pm2
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
