+# scanner() is derived separately from the accepted helper; only the continuation
+# unit, ExecStopPost path and budget entrypoints change. See scanner-binding.diff.
+def scanner():
+    h = H
+    base, scoped, deploy = h.components(); budget(900); h.unchanged(); h.release(deploy)
+    h.require((ROOT / 'auth-pass.json').exists(), 'AUTH_GATE_NOT_PASS')
+    h.record('scanner-attempt.json', {'recoveryBudget': 1, 'automaticRetry': False})
+    observed = h.readers(45)
+    if observed:
+        result = {'scanner': 'PASS_NATURAL_SCHEDULED_READER', 'recovery': 'NOT_REQUIRED', 'publications': observed}
+    else:
+        h.require(time.monotonic() - h.data('baseline.json')['startMonotonic'] < 340, 'RECOVERY_REMAINING_BUDGET_TOO_SHORT')
+        helper = h.scanner_module(); helper.LinuxHost(ID).guard()
+        args = ['/usr/bin/systemd-run', '--quiet', '--wait', '--unit', UNIT,
+            '--property=Type=exec', '--property=Restart=no', '--property=KillMode=control-group',
+            '--property=KillSignal=SIGKILL', '--property=RuntimeMaxSec=9min', '--property=TimeoutStopSec=20s',
+            '--property=UMask=0077', '--property=StandardOutput=append:' + str(ROOT / 'scanner-output.log'),
+            '--property=StandardError=null',
+            '--property=ExecStopPost=/usr/bin/python3 -I -B ' + str(ROOT / 'continuation-reviewed.py') + ' scanner-close',
+            '/usr/bin/python3', '-I', '-B', str(ROOT / 'recover-release-reviewed.py'), 'recover', '--id', ID]
+        try:
+            h.run(args, timeout=560)
+        except Exception:
+            phase, reason = 'UNKNOWN', 'SCANNER_UNIT_FAILED'
+            journal = helper.LinuxHost(ID).archive / 'state.json'
+            if journal.exists(): phase = json.loads(h.read(journal)).get('phase', 'UNKNOWN').upper()
+            output = ROOT / 'scanner-output.log'
+            if output.exists():
+                text = h.read(output).decode(); decoder = json.JSONDecoder()
+                while text.strip():
+                    text = text.lstrip()
+                    try: value, end = decoder.raw_decode(text)
+                    except ValueError: break
+                    text = text[end:]
+                    if value.get('recovery') == 'STOP' and re.fullmatch('[A-Za-z0-9_]{1,120}', value.get('reason', '')):
+                        reason = value['reason']
+            h.record('scanner-failure.json', {'CHECK_ID': 'SCANNER_' + phase, 'reason': reason, 'automaticRetry': False})
+            raise RuntimeError(reason)
+        finally:
+            closure = h.scanner_close()
+            h.require(closure['scannerClosure'] == 'PASS_COMPLETE', 'SCANNER_RECOVERY_FAILED_CLOSED')
+        budget(900)
+        result = {'scanner': 'PASS_ONE_RECOVERY', 'recovery': 'RECOVERED', 'publications':
+                  json.loads(h.read(helper.LinuxHost(ID).archive / 'scheduled.json'))}
+    h.record('scanner-pass.json', result); return result
+
+
+
+def begin_flow():
+    h = H; budget(1200)
+    h.require((ROOT / 'auth-pass.json').exists() and (ROOT / 'scanner-pass.json').exists(), 'AUTH_SCANNER_GATES_REQUIRED')
+    h.require(not (ROOT / 'first-failure.json').exists(), 'CONTINUATION_FAILED')
+    paused_idle(); target_empty()
+    h.require(h.scanner_module().LinuxHost(ID).reader() is not None, 'FRESH_READER_REQUIRED_BEFORE_UPLOAD')
+    h.record('flow-intent.json', {'imageUploads': 1, 'pdfUploads': 1, 'explicitScans': 1,
+                                'publishes': 1, 'automaticRetry': False})
+    return {'flow': 'ONE_UI_FLOW_UNLOCKED_NO_TERMINAL_UPLOAD_OR_SCAN_CALL'}
+
+
+def flow_proof():
+    h = H; budget(1200)
+    h.require((ROOT / 'flow-intent.json').exists(), 'ONE_FLOW_INTENT_REQUIRED')
+    # Existing DB image/CLEAN/version/audit/public-code and three operator observations.
+    result = h.flow_proof()
+    budget(1200)
+    h.record('functional-items.json', {'newLoginAndContext': h.data('auth-pass.json'),
+        'scannerReadiness': h.data('scanner-pass.json'),
+        'image': 'PASS_EXISTING_DB_AND_UI_GUARDS', 'pdfClean': 'PASS_EXISTING_DIGEST_POLICY_GUARDS',
+        'authorizedDownload': result['observations']['Authorized CLEAN PDF download SHA256 matched approved fixture'],
+        'publicDppAndAttachment': result['observations']['Published synthetic public DPP and image/PDF access without session'],
+        'audit': 'RETAINED_IN_FLOW_PASS_JSON', 'baselineRestored': 'PENDING_INDEPENDENT_CLOSE'})
+    return h.data('functional-items.json')
+
+
+def close():
+    h = H
+    if not (ROOT / 'baseline.json').exists():
+        return {'closure': 'NOT_STARTED_NO_AUTOMATION_CHANGES'}
+    if (ROOT / 'closure.json').exists():
+        return h.data('closure.json')
+    baseline = h.data('baseline.json'); pending = {}; restored = []
+    base, _, deploy = h.components()
+    with h.locked(h.BACKUP / 'job.lock'):
+        h.require(h.unit(UNIT + '.service')['ActiveState'] in ('inactive', 'failed'), 'CONTAIN_OWN_RECOVERY_BEFORE_CLOSE')
+        same_state = h.sha(h.read(h.BACKUP / 'state.json')) == baseline['backupSha256']
+        same_delivery = False; app_ready = False; paused_ready = False; clean_target_abort = False
+        try:
+            same_delivery = h.delivery(base) == baseline['delivery']
+            h.release(deploy); base.runtime()
+            h.require(h.http('https://staging.passvero.eu/') == '200 0', 'APP_NOT_READY')
+            app_ready = True
+            deploy.idle(); base.jobs(); h.writer_guard(paused=True)
+            h.require(base.reminders()['safeToFinalizePause'], 'UNRESOLVED_SENDING')
+            sending_gate()
+            paused_ready = True
+            target_empty(); clean_target_abort = True
+        except Exception:
+            pass
+        complete = (ROOT / 'functional-items.json').exists()
+        recovery_started = (ROOT / 'scanner-attempt.json').exists()
+        reader_ready = False
+        try: reader_ready = h.scanner_module().LinuxHost(ID).reader() is not None
+        except Exception: pass
+        safe_abort = clean_target_abort and not recovery_started
+        sending_safe = app_ready and paused_ready and same_state and same_delivery and (
+            (complete and reader_ready) or safe_abort)
+        if sending_safe:
+            h.require(baseline['timers'][h.TIMERS[2]]['ActiveState'] == 'active'
+                      and baseline['timers'][h.TIMERS[2]]['UnitFileState'] == 'enabled', 'SAVED_WRITER_BASELINE_NOT_ENABLED')
+            h.run(['/usr/bin/systemctl', 'enable', '--now', h.TIMERS[2]])
+            value = h.unit(h.TIMERS[2]); trigger = h.unit('passvero-subscription-reminders.service')
+            h.require(value['ActiveState'] == 'active' and value['UnitFileState'] == 'enabled'
+                      and trigger['TriggeredBy'] == h.TIMERS[2], 'WRITER_RESUME_NOT_VERIFIED')
+            restored.append(h.TIMERS[2])
+        else:
+            pending[h.TIMERS[2]] = 'APP_OR_DELIVERY_OR_SCANNER_FLOW_GATE_NOT_PROVEN_REVIEW_REQUIRED'
+        # These timers were never paused by this continuation. Never trigger/catch up a job.
+        for name in h.TIMERS[:2]:
+            value = h.unit(name)
+            if value['ActiveState'] != 'active' or value['UnitFileState'] != 'enabled':
+                pending[name] = 'UNEXPECTED_EXTERNAL_TIMER_CHANGE_NO_AUTOMATIC_REPAIR'
+        if not same_state: pending['backupState'] = 'CHANGED_REVIEW_REQUIRED'
+        if not same_delivery: pending['delivery'] = 'NOT_PROVEN_UNCHANGED'
+    result = {'closure': 'PASS_BASELINE_RESTORED' if not pending else 'PARTIAL_AUTOMATION_RESTORE',
+        'restored': restored, 'pending': pending, 'backupStateUnchanged': same_state,
+        'deliveryUnchangedBeforeSendingResume': same_delivery,
+        'backupAndMonitorChangedByContinuation': False,
+        'functionalContinuation': 'PASS_CURRENT_STATE_ONLY' if complete and not pending else 'NOT_PROVEN',
+        'historicalAutomaticStartup': 'PASS_ACCEPTED_REFERENCE_ONLY',
+        'historicalFullServiceRecovery': 'NOT_PROVEN_NOT_RETROACTIVELY_CHANGED',
+        'ordinaryApprovedSending': 'RESUMED_BY_SAVED_TIMER' if restored else 'NOT_RESUMED',
+        'artifactsRetained': True, 'automaticRetry': False}
+    h.record('closure.json', result)
+    return result
+
+
+def contain():
+    h = H
+    h.require((ROOT / 'scanner-attempt.json').exists(), 'NO_OWN_SCANNER_ATTEMPT')
+    if h.unit(UNIT + '.service')['ActiveState'] in ('active', 'activating', 'deactivating'):
+        h.run(['/usr/bin/systemctl', 'stop', UNIT + '.service'], timeout=35)
+    host = h.scanner_module().LinuxHost(ID)
+    if (host.archive / 'state.json').exists():
+        host.contain()
+    return {'containment': 'OWN_ATTEMPT_ONLY_ARTIFACTS_RETAINED', 'next': 'CLOSE'}
+
+
+def main(mode):
+    h = H
+    h.require(os.geteuid() == 0 and os.uname().nodename == 'srv1834647', 'OPERATOR_HOST')
+    if mode != 'preflight':
+        h.require(ROOT.is_dir() and not ROOT.is_symlink(), 'CONTINUATION_NOT_INSTALLED')
+    actions = {'preflight': preflight, 'coordinate': coordinate, 'auth': auth, 'scanner': scanner,
+               'begin-flow': begin_flow, 'flow-proof': flow_proof, 'close': close,
+               'contain': contain, 'scanner-close': h.scanner_close}
+    h.require(mode in actions, 'MODE_NOT_REVIEWED_NO_REBOOT_OR_STARTUP_MODE')
+    if mode not in ('preflight', 'close', 'contain', 'scanner-close'):
+        h.require(LOCAL_CONTINUATION_PROOF_ACCEPTED, 'NEW_CONTINUATION_EXECUTABLE_PROOF_PENDING_STOP')
+    try:
+        if mode in ('preflight', 'scanner-close'):
+            result = actions[mode]()
+        else:
+            with h.locked(ROOT / 'operation.lock'): result = actions[mode]()
+        print(json.dumps(result, indent=2, sort_keys=True)); return 0
+    except BaseException as error:
+        reason = str(error) if re.fullmatch('[A-Za-z0-9_]{1,160}', str(error)) else type(error).__name__
+        result = {'result': 'STOP', 'CHECK_ID': 'CONTINUATION_' + mode.upper().replace('-', '_'),
+                  'reason': reason, 'automaticRetry': False, 'instruction': 'RETURN_OUTPUT_NO_RETRY_INDEPENDENT_CLOSE'}
+        if mode != 'preflight' and not (ROOT / 'first-failure.json').exists():
+            h.record('first-failure.json', result)
+        print(json.dumps(result, indent=2)); return 1
+
+
+if __name__ == '__main__':
+    # Transient ExecStopPost uses the same private source package, independently of parent lock.
+    import hashlib
+    import importlib.util
+    import stat
+    import sys
+    manifest_path = ROOT / 'source-package.json'
+    info = ROOT.lstat()
+    if not stat.S_ISDIR(info.st_mode) or ROOT.is_symlink() or info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o700:
+        raise SystemExit('CONTINUATION_ROOT_POSTURE')
+    info = manifest_path.lstat()
+    if manifest_path.is_symlink() or info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o600:
+        raise SystemExit('CONTINUATION_MANIFEST_POSTURE')
+    pins = json.loads(manifest_path.read_text())['files']
+    expected_names = {'reboot-reviewed.py', 'preflight.py', 'remaining-backup-and-actor-readonly.py',
+                      'recover-release-reviewed.py', 'continuation-reviewed.py'}
+    if set(pins) != expected_names: raise SystemExit('CONTINUATION_PACKAGE_SCOPE')
+    modules = {}
+    for name, pin in pins.items():
+        path = ROOT / name; info = path.lstat()
+        if (not stat.S_ISREG(info.st_mode) or path.is_symlink() or info.st_uid != 0
+                or stat.S_IMODE(info.st_mode) != 0o600 or hashlib.sha256(path.read_bytes()).hexdigest() != pin):
+            raise SystemExit('CONTINUATION_SOURCE_CHANGED')
+        if name == 'continuation-reviewed.py': continue
+        spec = importlib.util.spec_from_file_location('continuation_' + name.replace('.', '_'), path)
+        module = importlib.util.module_from_spec(spec); spec.loader.exec_module(module); modules[name] = module
+    configure(modules['reboot-reviewed.py'], modules['preflight.py'],
+              modules['remaining-backup-and-actor-readonly.py'], modules['recover-release-reviewed.py'])
+    raise SystemExit(main(sys.argv[1]))
