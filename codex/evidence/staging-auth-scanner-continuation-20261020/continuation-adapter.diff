+def budget(seconds):
+    h = H; baseline = h.data('baseline.json')
+    h.require(h.boot_id() == baseline['bootId'], 'BOOT_CHANGED_NO_REBOOT_ALLOWED')
+    h.require(0 <= time.monotonic() - baseline['startMonotonic'] <= seconds, 'CONTINUATION_BUDGET_EXPIRED')
+
+
+def coordinate():
+    h = H; base, _, deploy = h.components()
+    h.require(not (ROOT / 'baseline.json').exists(), 'CONTINUATION_ALREADY_STARTED')
+    fresh = preflight()
+    with h.locked(h.BACKUP / 'job.lock'):
+        h.release(deploy); h.drain_writer(); h.idle(base, deploy); target_empty()
+        due = h.due(deploy, 2700); h.production_job_window(deploy)
+        h.record('baseline.json', {'t0': time.time(), 'startMonotonic': time.monotonic(),
+            'bootId': h.boot_id(), 'timers': fresh['timers'], 'due': due,
+            'backupSha256': h.sha(h.read(h.BACKUP / 'state.json')), 'delivery': h.delivery(base),
+            'startupReference': fresh['history'], 'pauseScope': 'WRITER_ONLY'})
+        h.END = h.data('baseline.json')['t0'] + 1800
+        h.run(['/usr/bin/systemctl', 'disable', '--now', h.TIMERS[2]])
+        paused_idle()
+        h.require(h.delivery(base) == h.data('baseline.json')['delivery'], 'SENDING_RACE_DURING_PAUSE')
+        h.record('coordinated.json', {'result': 'WRITER_PAUSED_BACKUP_MONITOR_UNCHANGED'})
+    return h.data('coordinated.json')
+
