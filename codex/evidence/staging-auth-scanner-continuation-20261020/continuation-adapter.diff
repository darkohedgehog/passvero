+"""Operator-gated continuation adapter. Focused local doubles proof is recorded.
+No reboot/startup mode. The reviewed raw-TTY library bytes remain unchanged.
+"""
+import json
+import os
+import pathlib
+import re
+import time
+
+ID = 'continuation-20261020-auth-flow-01'
+ROOT = pathlib.Path('/var/lib/passvero-auth-flow-continuation-20261020-01')
+PRIOR = pathlib.Path('/var/lib/passvero-reboot-recovery-20261019')
+UNIT = 'passvero-auth-flow-scanner-20261020-01'
+LOCAL_CONTINUATION_PROOF_ACCEPTED = True
+LIBRARY_PIN = '4da924e0640d13fbe9858a7bd6a6899891ebcb43ca4f3e6ae52dc09e388722d1'
+INSTALLED_PIN = '303c110ea2ff3fa081f53818a27d20238b2621b3b00f444f0b8d5817ab2d87d7'
+PRIOR_MANIFEST_PIN = 'dd9335c96a78f61341b99a5600b251fc95e55e7ceaf390bbc0e46a997dc842aa'
+H = None
+
+
+def configure(h, base, scoped, scanner):
+    global H
+    H = h
+    # Explicit continuation namespace, not old main()/modes or fabricated startup markers.
+    h.ROOT = ROOT
+    h.ATTEMPT = ID
+    h.BOOTSTRAP_COMPONENTS = (base, scoped, h.load('pinned_deploy', h.DEPLOY, h.DEPLOY_PIN))
+    h.BOOTSTRAP_SCANNER = scanner
+    if (ROOT / 'baseline.json').exists():
+        h.END = h.data('baseline.json')['t0'] + 1800
+
+
+def historical_reference():
+    h = H
+    manifest = h.read(PRIOR / 'package.json')
+    h.require(h.sha(manifest) == PRIOR_MANIFEST_PIN, 'PRIOR_INSTALLED_MANIFEST_DRIFT')
+    h.require(h.sha(h.read(PRIOR / 'reboot-reviewed.py')) == INSTALLED_PIN, 'PRIOR_INSTALLED_HELPER_DRIFT')
+    for name, pin in json.loads(manifest)['files'].items():
+        h.require(name in ('preflight.py', 'preparation-readonly.py', 'reboot-reviewed.py',
+                          'recover-release-reviewed.py', 'remaining-backup-and-actor-readonly.py'), 'PRIOR_SCOPE')
+        h.require(h.sha(h.read(PRIOR / name)) == pin, 'PRIOR_MEMBER_DRIFT')
+    startup = json.loads(h.read(PRIOR / 'startup-pass.json'))
+    closed = json.loads(h.read(PRIOR / 'abort-writer-resume-pass.json'))
+    h.require(startup['AUTOMATIC_STARTUP'] == 'PASS'
+              and startup['bootId'] == '379fc52e-5524-4b93-b6ec-b036d1953db7', 'ACCEPTED_STARTUP_REFERENCE_DRIFT')
+    h.require(closed['closure'] == 'PASS_POST_STARTUP_ABORT_BASELINE_RESTORED', 'PRIOR_NOT_CLOSED')
+    return {'classification': 'HISTORICAL_ACCEPTED_NOT_NEW_STARTUP_OBSERVATION',
+            'startup': startup['AUTOMATIC_STARTUP'], 'acceptedBootId': startup['bootId'],
+            'priorClosed': closed['closure'], 'installedHelperSha256': INSTALLED_PIN}
+
+
+def target_empty():
+    h = H; base, scoped, _ = h.components()
+    actor = scoped.actor(); rights = scoped.validate_actor(actor)
+    h.require(actor['users'][0]['membershipRole'] == 'ADMIN'
+              and actor['users'][0]['membershipId'] == 'b954c03b-9c81-4760-bd63-83127b56bbb6', 'ACTOR_MEMBERSHIP_DRIFT')
+    product = actor['product']
+    h.require(product['draftId'] == 'a2e0ebe2-8305-4975-84f2-83b16d505536'
+              and product['publishedId'] is None, 'TARGET_ALREADY_CHANGED_NO_DUPLICATE_FLOW')
+    fixture = base.fixture()
+    h.require(not fixture['imageReferences'] and not fixture['documentReferences'], 'TARGET_ALREADY_HAS_REFERENCES_STOP_NO_UPLOAD')
+    existing = base.sql('''SELECT json_build_object(
+      'images',(SELECT count(*) FROM "ProductImageAsset" WHERE "organizationId"='bdc5aed5-b05a-42e6-895b-9f2f9f8a79a0' AND "originalFilename"='SYNTHETIC-STAGING-REBOOT-20261014.png'),
+      'pdfs',(SELECT count(*) FROM "Document" WHERE "organizationId"='bdc5aed5-b05a-42e6-895b-9f2f9f8a79a0' AND ("originalFilename"='SYNTHETIC-STAGING-REBOOT-20261013.pdf' OR "checksumSha256"='fb914f8e768c1d5708f3bb3e2cd0c18ffd43095b235e06d8920f4f8445c245ec')))''')
+    h.require(existing == {'images': 0, 'pdfs': 0}, 'PRIOR_FIXTURE_ASSET_PRESENT_REVIEW_REUSE_NO_DUPLICATE')
+    return {'actor': actor, 'rights': rights, 'existingFixtureAssets': existing}
+
+
+def sending_gate():
+    h = H; base, _, _ = h.components()
+    value = base.sql('SELECT json_build_object(\'unresolvedAccessNotices\',count(*)) FROM "AccessRequestAdminNotification" WHERE status NOT IN (\'SENT\',\'REJECTED\')')
+    h.require(value == {'unresolvedAccessNotices': 0}, 'UNRESOLVED_ACCESS_NOTICE_SENDING_STOP')
+    return value
+
+
+def paused_idle():
+    h = H; base, _, deploy = h.components()
+    deploy.idle(); base.jobs(); h.writer_guard(paused=True)
+    h.require(h.unit(UNIT + '.service')['ActiveState'] in ('inactive', 'failed'), 'CONTINUATION_RECOVERY_ACTIVE')
+    h.require(base.reminders()['safeToFinalizePause'], 'UNRESOLVED_SENDING')
+    sending_gate()
+
+
+def preflight():
+    h = H; base, _, deploy = h.components()
+    h.require(not (ROOT / 'baseline.json').exists(), 'CONTINUATION_ALREADY_STARTED_NO_REOPEN')
+    history = historical_reference()
+    h.release(deploy); runtime = base.runtime(); backup = base.backup()
+    h.drain_writer(); h.idle(base, deploy); sending_gate()
+    h.require(h.unit(UNIT + '.service')['ActiveState'] in ('inactive', 'failed'), 'CONTINUATION_UNIT_ACTIVE')
+    due = h.due(deploy, 2700); production_job = h.production_job_window(deploy)
+    timers = {name: h.unit(name) for name in h.TIMERS}
+    h.require(all(v['ActiveState'] == 'active' and v['UnitFileState'] == 'enabled' for v in timers.values()), 'AUTOMATION_BASELINE_DRIFT')
+    target = target_empty()
+    scanner = h.scanner_module(); scanner.LinuxHost(ID).guard()
+    with h.locked(scanner.RECORDS / 'operator.lock'):
+        for path in scanner.RECORDS.glob('*/state.json'):
+            h.require(json.loads(h.read(path)).get('phase') in ('COMPLETE', 'ROLLED_BACK'), 'UNRESOLVED_SCANNER_RECOVERY')
+        h.require(not (scanner.RECORDS / ID).exists(), 'RECOVERY_ID_ALREADY_USED')
+    reader = scanner.LinuxHost(ID).reader()
+    return {'preflight': 'CURRENT_SCOPED_FACTS_ONLY', 'executionUnlocked': False,
+            'continuationId': ID, 'observedEpoch': time.time(), 'history': history,
+            'runtime': runtime, 'backup': backup, 'timers': timers, 'due': due,
+            'productionJobWindow': production_job, 'target': target,
+            'reader': reader, 'recovery': 'SKIP_IF_FRESH_ACCEPTED_ELSE_ONE_REVIEWED_ATTEMPT',
+            'scannerHelperSha256': h.SCANNER_PIN, 'rollback': h.verify_rollback(deploy),
+            'localFixtures': 'SEPARATE_LOCAL_MAC_HASH_RESULT_REQUIRED_NO_SERVER_TRANSFER_NEEDED',
+            'newContinuationProof': 'PASS_LOCAL_TWO_PATH_DOUBLES_ONLY_NOT_LIVE', 'mutations': 'NONE'}
+
