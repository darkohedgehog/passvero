+def auth():
+    h = H; base, scoped, _ = h.components(); budget(600)
+    h.require((ROOT / 'coordinated.json').exists(), 'COORDINATION_REQUIRED')
+    h.require(not (ROOT / 'first-failure.json').exists(), 'CLOSED_OR_FAILED_CONTINUATION')
+    h.record('auth-attempt.json', {'automaticRetry': False})
+    scoped.validate_actor(scoped.actor())
+    observations = {'newPasswordLogin': h.ask('New password login, no reset/verification email', 600),
+                    'organizationContext': h.ask('Exact approved organization, ADMIN membership, product/draft and entitlement/quota UI', 600)}
+    scoped.validate_actor(scoped.actor())
+    t0 = h.data('baseline.json')['t0']
+    proof = base.sql('''SELECT json_build_object(
+      'freshActiveSessions',count(DISTINCT s.id),
+      'freshSelectedOrganizationSessions',count(DISTINCT s.id) FILTER (WHERE c."selectedOrganizationId"='bdc5aed5-b05a-42e6-895b-9f2f9f8a79a0'))
+      FROM "AuthIdentity" i JOIN "AuthProviderSession" s ON s."userId"=i."providerSubject"
+      LEFT JOIN "AuthSessionSelection" c ON c.provider='BETTER_AUTH' AND c."providerSessionId"=s.id
+      WHERE i."userId"='40e51001-912c-4bcf-aa45-d866632aac85' AND i.provider='BETTER_AUTH' AND i."revokedAt" IS NULL
+      AND s."createdAt">=to_timestamp(%s) AND s."expiresAt">clock_timestamp()''' % t0)
+    h.require(proof == {'freshActiveSessions': 1, 'freshSelectedOrganizationSessions': 1}, 'FRESH_SERVER_SESSION_AND_ORG_SELECTION_NOT_PROVEN')
+    budget(600); h.record('auth-pass.json', {'observations': observations, 'serverProof': proof})
+    return h.data('auth-pass.json')
+
